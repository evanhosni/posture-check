{
  "manifest_version": 3,
  "name": "Posture Check",
  "description": "Watches your posture through the webcam and alerts you when you start to slouch",
  "permissions": [
    "storage",
    "notifications",
    "alarms",
    "tabs",
    "tts"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "Posture Check",
    "default_icon": {
      "16": "icons/icon16-off.png",
      "32": "icons/icon32-off.png",
      "48": "icons/icon48-off.png",
      "128": "icons/icon128-off.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "posture-check@ehosni.dev",
      "strict_min_version": "128.0"
    }
  }
}
