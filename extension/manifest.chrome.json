{
  "manifest_version": 3,
  "name": "Posture Check",
  "description": "Watches your posture through the webcam and sounds off when you start slouching.",
  "minimum_chrome_version": "116",
  "permissions": [
    "offscreen",
    "storage",
    "notifications",
    "alarms",
    "tabs",
    "tts"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Posture Check \u2014 off",
    "default_icon": {
      "16": "icons/icon16-off.png",
      "32": "icons/icon32-off.png",
      "48": "icons/icon48-off.png",
      "128": "icons/icon128-off.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
